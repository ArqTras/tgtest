# Token from @BotFather. Without it the stack starts, but Telegram stays offline.
TELEGRAM_BOT_TOKEN=

# Default: local Ollama inside this Compose stack (qwen3:14b → qwen3-14b-bot).
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-14b-bot

# Local CPU models need a long read timeout (seconds)
LLM_TIMEOUT=300

# Optional Ollama tuning (used by ollama-init on first boot)
OLLAMA_BASE_MODEL=qwen3:14b
OLLAMA_LOCAL_MODEL=qwen3-14b-bot
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_THREAD=16
OLLAMA_PORT=11434

# Cloud alternatives (override the three LLM_* lines above):
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com  LLM_API_KEY=sk-...  LLM_MODEL=deepseek-flash
# Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=gsk_...  LLM_MODEL=llama-3.3-70b-versatile

# Status-page admin password. Generate with: openssl rand -hex 18
ADMIN_TOKEN=

HTTP_PORT=8787
ALLOW_PRIVATE_URLS=false
LEARN_EVERY=1
